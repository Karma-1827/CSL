# Template Nginx server block for MPTS (docs/VULNERABILITY_SCAN_IMPROVEMENTS.md batch 8
# item 2). This is a TEMPLATE, not a ready-to-use config: every value marked TODO depends
# on the allocated DNS name, TLS certificate, deployment path, and approved network ranges.
# DNS and the NTNU VPN range are filled from the 2026-08-17 IT Center handoff;
# certificate and filesystem paths remain TODO (see docs/DEPLOY.md). Copy this file and
# proxy_params_mpts.conf to /etc/nginx/, fill in the TODOs, symlink into
# /etc/nginx/sites-enabled/, then `nginx -t` before reloading.
#
# Prerequisites this config assumes:
#   - Gunicorn is running via deploy/systemd/mpts-gunicorn.service, bound to the Unix
#     socket referenced below (must match deploy/gunicorn.conf.py's GUNICORN_BIND).
#   - `python manage.py collectstatic` has been run so STATIC_ROOT (staticfiles/) exists.
#   - TLS certificates are already issued and readable by nginx.
#
# The TODO placeholders are written so an un-edited copy of this file fails `nginx -t`
# outright (invalid CIDR syntax, nonexistent cert paths) rather than silently loading
# with a nonsensical-but-valid config — deliberate, not a typo.

# sites-enabled files are normally included from nginx.conf's http block, so these
# shared zones belong here. Keep the general rate high enough for normal dashboard and
# static-asset bursts; Django's shared login/recovery throttles remain the account-level
# protection. Move these directives to the http block if the VM uses another include
# layout, then verify the final configuration with `nginx -t`.
server_tokens off;
limit_req_zone $binary_remote_addr zone=mpts_requests:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=mpts_connections:10m;

upstream mpts_app {
    server unix:/run/mpts/gunicorn.sock fail_timeout=0;
}

# IPv6 listeners intentionally omitted: the allocated VM (2026-08-17 IT Center handoff)
# has IPv6 disabled at the kernel level (`ip -6 addr show` empty,
# /sys/module/ipv6/parameters/disable=1) — `listen [::]:80/443` makes nginx fail to start
# entirely ("socket() [::]:80 failed (97: Address family not supported by protocol)"), not
# just skip IPv6. Re-add the `listen [::]:...` lines only if a future host actually has
# IPv6 enabled.
#
# Plain HTTP only exists to redirect to HTTPS (and to answer ACME HTTP-01 challenges if
# certbot/acme.sh is used for renewal — add a location for that here if needed).
server {
    listen 80;
    server_name mpts.tcsl.ntnu.edu.tw;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name mpts.tcsl.ntnu.edu.tw;

    client_header_timeout 15s;
    client_body_timeout 30s;
    keepalive_timeout 30s;
    send_timeout 120s;

    limit_req zone=mpts_requests burst=40 nodelay;
    limit_req_status 429;
    limit_conn mpts_connections 40;
    limit_conn_status 429;

    ssl_certificate     TODO/etc/ssl/mpts/fullchain.pem;
    ssl_certificate_key TODO/etc/ssl/mpts/privkey.pem;

    # Reject legacy TLS. The cipher list applies to TLS 1.2; TLS 1.3 suites follow the
    # installed OpenSSL/Nginx defaults and must be checked again on the actual VM.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305';
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MPTS_SSL:10m;
    ssl_session_tickets off;

    # Largest single upload today is a class document at 10 MB (tutoring/models.py
    # validate_class_document_file); a little headroom above that for request overhead.
    client_max_body_size 12m;

    access_log /var/log/nginx/mpts_access.log;
    error_log  /var/log/nginx/mpts_error.log;

    location = /favicon.ico { access_log off; log_not_found off; }

    # Matches STATIC_ROOT in config/settings.py. Re-run collectstatic and reload nginx
    # (not required, just to pick up new files — nginx reads the directory live) after
    # every deploy that changes static/.
    location /static/ {
        alias TODO/opt/mpts/staticfiles/;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Reserved for the private-download views (accounts:download_qualification,
    # tutoring:download_class_record_attachment, accounts:download_class_document) to
    # X-Accel-Redirect into, once DJANGO_X_ACCEL_REDIRECT=1 is set on the app (see
    # docs/DEPLOY.md item 13 — not wired up yet, so this location is currently unused and
    # every download still streams through Django's own FileResponse). `internal` means
    # this can only be reached via an X-Accel-Redirect from the app, never a direct
    # client request, so nginx here is not itself doing the permission check — Django
    # already did that before issuing the redirect.
    location /protected-media/ {
        internal;
        alias TODO/opt/mpts/media/;
    }

    # /system-admin/ 初期只允許資訊中心核配的師大 VPN 網段。若資訊中心日後另行
    # 核准校內來源網段，再以書面資料追加；不可用 0.0.0.0/0 或留空等同開放。
    location /system-admin/ {
        allow 140.122.57.0/24;       # 師大 VPN 網段（資訊中心開通信 2026-08 確認）
        deny all;

        proxy_pass http://mpts_app;
        include proxy_params_mpts.conf;
    }

    location / {
        proxy_pass http://mpts_app;
        include proxy_params_mpts.conf;
    }
}
