# Production environment file template (docs/VULNERABILITY_SCAN_IMPROVEMENTS.md batch 8
# item 6). Copy to /opt/mpts/.env on the VM, fill in every TODO with real values, then
# `chmod 600` it and make sure it's owned by the service user (deploy/systemd/*.service
# read it via EnvironmentFile=). Never commit a filled-in copy of this file — it will
# contain the real secret key and database password.
#
# The root .env.example (repo root) is the dev-oriented version with safe defaults for
# `manage.py runserver`; this file is the production-oriented version showing every
# variable that actually matters once DJANGO_DEBUG=0, including the ones config/
# settings.py fail-closed checks (batch 2) will refuse to start without.

# --- Core Django (config/settings.py fail-closed checks apply to all three of these) ---
DJANGO_DEBUG=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must NOT equal the dev fallback string baked into config/settings.py.
DJANGO_SECRET_KEY=TODO-generate-a-real-random-secret-and-never-reuse-the-dev-one
# Comma-separated, no scheme, no wildcard, not just localhost/127.0.0.1.
DJANGO_ALLOWED_HOSTS=TODO-mpts.example.ntnu.edu.tw
# Comma-separated scheme://host origins (batch 2). Must match the real HTTPS domain.
DJANGO_CSRF_TRUSTED_ORIGINS=https://TODO-mpts.example.ntnu.edu.tw

# --- PostgreSQL ---
POSTGRES_DB=TODO
POSTGRES_USER=TODO
POSTGRES_PASSWORD=TODO-generate-a-real-random-password
# Empty/unset means "connect via local Unix socket"; set to a hostname only if PostgreSQL
# is on a separate host (see docs/DEPLOY.md "上線前仍待確認").
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- Gunicorn (deploy/gunicorn.conf.py reads these; all have working defaults if unset) ---
# GUNICORN_BIND=unix:/run/mpts/gunicorn.sock
# GUNICORN_WORKERS=
# GUNICORN_TIMEOUT=60
# GUNICORN_ACCESS_LOG=-
# GUNICORN_ERROR_LOG=-
# GUNICORN_LOG_LEVEL=info

# --- Demo/seed commands (batch 1) ---
# Must NOT be set to 1 in production. Leaving it unset is the safe default; the seed
# commands already also require DJANGO_DEBUG=1, so this is defense in depth, not the only
# guard.
ALLOW_DEMO_SEED=0
