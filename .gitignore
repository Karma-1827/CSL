# Python
.venv/
__pycache__/
*.pyc

# Django
*.sqlite3
db.sqlite3

# 環境變數與機密;.env.example 與 deploy/.env.production.example 是不含機密的範本，
# 需要進版控供部署參考;實際填好機密的 .env 一律不進版控。
.env
.env.*
!.env.example
!deploy/.env.production.example

# 使用者上傳與真實資料(勿提交真實個資或資格文件)
media/

# 學校提供的內部行政/資安文件(非公開,不進版控)
學校文件/

# 私有授權字型與系戳(須由獲授權的部署環境另行提供,不得推送至公開 repository)
assets/fonts/DFLiSongStd-W*.otf
assets/fonts/DFLiSongStd-W*.ttf
assets/fonts/Helvetica Neue*.ttf
assets/certificates/

# 本機人工檢查用預覽與會議用二進位文件(PDF/DOCX),不是正式資料來源,也不適合放進版控
output/
outputs/

# 給其他 AI agent 用的獨立寫作風格 skill,本身是另一個 repo 的完整 clone(含自己的 .git),
# 不是本專案程式碼,刻意不進版控;AGENTS.md 的路徑指到這裡,只在有這份本機 clone 時生效。
skills/

# 測試時的暫存圖片
tmp/pdfs/

# 編輯器/系統
.DS_Store
.vscode/
.idea/

# Node(若未來有用到)
node_modules/

