# DJANGO_DEBUG=0 (production) enforces fail-closed checks in config/settings.py:
# DJANGO_SECRET_KEY must be set to a real secret (not this placeholder), POSTGRES_PASSWORD
# must not be blank, and DJANGO_ALLOWED_HOSTS must list real hostnames (not empty, "*", or
# only localhost/127.0.0.1). The app refuses to start otherwise.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of scheme://host origins trusted for unsafe (POST/PUT/etc.) requests
# behind HTTPS, e.g. https://mpts.example.ntnu.edu.tw. Required once behind a real domain.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Number of reverse-proxy hops in front of this app that add their own trustworthy
# X-Forwarded-For value (accounts/forms.py::client_ip()). 0 (default) means "don't trust
# X-Forwarded-For at all, use the real socket peer" — correct for local dev with no
# proxy. Only set to 1 once deploy/nginx/mpts.conf.example is actually in place in front.
DJANGO_TRUSTED_PROXY_COUNT=0
POSTGRES_DB=qiangqiang
POSTGRES_USER=qiangqiang
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

